# Installation payloads. The stage3 tarball is ~255 MB, well past GitHub's
# per-file limit, and it is reproducible from the URL recorded in the scripts.
downloads/

# Build logs are large, machine-specific and regenerated on every run.
logs/

# Local GPG keyring used to verify the stage3 signature.
.gnupg/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Editors
*.swp
.idea/
.vscode/

# Benchmark results are deliberately NOT ignored: comparing runs across OS
# configurations is the point of this repository. A run collected off the
# target therefore has to be copied out of logs/from-target/ into results/,
# which is ignored below - the diagnostics in that bundle (dmesg, lspci) are
# bulky and machine-specific, but the result JSON is the deliverable.

# QEMU smoke-test scratch (kernel image copy, overlay files)
.vmtest/

# Diagnostics copied back off the target after a bare-metal boot
logs/from-target/
